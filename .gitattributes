* text=auto
*.go text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Embedded build output is byte-compared by the CI dist gate and served with
# fingerprinted immutable caching. Line-ending normalisation would rewrite the
# bytes on Windows checkouts and break both.
internal/web/dist/** -text
