NVIDIA_ROUTER_LISTEN_ADDR=0.0.0.0:3756
NVIDIA_ROUTER_DATA_DIR=/data
NVIDIA_ROUTER_TEMP_DIR=/tmp
NVIDIA_ROUTER_MASTER_KEY=<Raw URL Base64 32 bytes>
NVIDIA_ROUTER_INITIAL_ADMIN_PASSWORD=<at least 12 characters; inject at runtime>
NVIDIA_ROUTER_ADMIN_SECURE_COOKIE=false
NVIDIA_ROUTER_ADMIN_EXTERNAL_ORIGIN=
NVIDIA_ROUTER_TRUSTED_PROXY_CIDRS=
NVIDIA_ROUTER_NVIDIA_BASE_URL=https://integrate.api.nvidia.com
# Optional bootstrap configuration for the standalone Xingkong proxy-pool service.
# The admin "代理池" page takes precedence after a database configuration is saved.
NVIDIA_ROUTER_XK_PROXY_URL=
NVIDIA_ROUTER_XK_PROXY_AUTH_KEY=
