NVIDIA_ROUTER_LISTEN_ADDR=0.0.0.0:3756
NVIDIA_ROUTER_DATA_DIR=/data
NVIDIA_ROUTER_TEMP_DIR=/tmp
NVIDIA_ROUTER_MASTER_KEY=<Raw URL Base64 32 bytes>
NVIDIA_ROUTER_MASTER_KEY_VERSION=1
# Keep the old key only during an explicit rotation compatibility window.
NVIDIA_ROUTER_LEGACY_MASTER_KEY=
NVIDIA_ROUTER_LEGACY_MASTER_KEY_VERSION=1
NVIDIA_ROUTER_INITIAL_ADMIN_PASSWORD=<at least 12 characters; inject at runtime>
NVIDIA_ROUTER_ADMIN_SECURE_COOKIE=false
NVIDIA_ROUTER_ADMIN_EXTERNAL_ORIGIN=
NVIDIA_ROUTER_TRUSTED_PROXY_CIDRS=
NVIDIA_ROUTER_NVIDIA_BASE_URL=https://integrate.api.nvidia.com
# Built-in Xingkong collector. This is an optional bootstrap/fallback value;
# the admin page can also encrypt and persist a full XApi URL in the database.
# Keep real credentials out of Git and never echo them.
NVIDIA_ROUTER_XK_UPSTREAM_URL=
NVIDIA_ROUTER_XK_VALIDATION_URL=
NVIDIA_ROUTER_XK_VALIDATION_STATUS=404
NVIDIA_ROUTER_XK_UPSTREAM_TIMEOUT=4s
NVIDIA_ROUTER_XK_VALIDATION_TIMEOUT=5s
NVIDIA_ROUTER_XK_COLLECT_INTERVAL=5s
NVIDIA_ROUTER_XK_PROXY_TTL=120s
NVIDIA_ROUTER_XK_EXPECTED_QTY=2
NVIDIA_ROUTER_XK_CONCURRENCY=2

# Optional Litestream continuous replication (docker-compose.litestream.yml).
# Provider-specific credentials (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_SESSION_TOKEN / AWS_REGION, or LITESTREAM_ACCESS_KEY_ID / SECRET /
# LITESTREAM_S3_ENDPOINT for non-AWS S3-compatible stores) are read from the
# host environment at runtime and must NOT be written into .env for git safety.
LITESTREAM_REPLICA_URL=s3://nvidia-router-backups/router
